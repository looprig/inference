            "service_tier": {
              "$ref": "#/$defs/ServiceTier"
            },
            "stop": {
              "$ref": "#/$defs/StopConfiguration"
            },
            "store": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "stream": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "stream_options": {
              "$ref": "#/$defs/ChatCompletionStreamOptions"
