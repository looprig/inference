            "tool_choice": {
              "$ref": "#/$defs/ChatCompletionToolChoiceOption"
            },
            "tools": {
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/ChatCompletionTool"
                  },
                  {
                    "$ref": "#/$defs/CustomToolChatCompletions"
                  }
                ]
              },
              "type": "array"
            },
            "top_logprobs": {
              "maximum": 20,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "verbosity": {
              "$ref": "#/$defs/Verbosity"
