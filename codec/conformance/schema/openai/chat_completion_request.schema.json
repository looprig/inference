                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "approximate"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                }
              },
              "title": "Web search",
              "type": "object"
            }
          },
          "required": [
            "model",
            "messages"
          ],
          "type": "object"
        }
      ]
