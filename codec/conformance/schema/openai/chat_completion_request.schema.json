                  "$ref": "#/$defs/ResponseFormatJsonSchema"
                },
                {
                  "$ref": "#/$defs/ResponseFormatJsonObject"
                }
              ]
            },
            "seed": {
              "maximum": 9223372036854776000,
              "minimum": -9223372036854776000,
              "type": [
                "integer",
                "null"
              ]
