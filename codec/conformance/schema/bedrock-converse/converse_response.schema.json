{
  "$defs": {
    "AccountId": {
      "pattern": "^[0-9]{12}$",
      "type": "string"
    },
    "AppliedGuardrailDetails": {
      "properties": {
        "guardrailArn": {
          "$ref": "#/$defs/GuardrailArn"
        },
        "guardrailId": {
          "$ref": "#/$defs/GuardrailId"
        },
        "guardrailOrigin": {
          "$ref": "#/$defs/GuardrailOriginList"
        },
        "guardrailOwnership": {
          "$ref": "#/$defs/GuardrailOwnership"
        },
        "guardrailVersion": {
          "$ref": "#/$defs/GuardrailVersion"
        }
      },
      "type": "object"
    },
    "AudioBlock": {
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorBlock"
        },
        "format": {
          "$ref": "#/$defs/AudioFormat"
        },
        "source": {
          "$ref": "#/$defs/AudioSource"
        }
      },
      "required": [
        "format",
        "source"
      ],
      "type": "object"
    },
    "AudioFormat": {
      "enum": [
        "aac",
        "flac",
        "m4a",
        "mka",
        "mkv",
        "mp3",
        "mp4",
        "mpeg",
        "mpga",
        "ogg",
        "opus",
        "pcm",
        "wav",
        "webm",
        "x-aac"
      ],
      "type": "string"
    },
    "AudioSource": {
      "oneOf": [
        {
          "required": [
            "bytes"
          ]
        },
        {
          "required": [
            "s3Location"
          ]
        }
      ],
      "properties": {
        "bytes": {
          "contentEncoding": "base64",
          "minLength": 1,
          "type": "string"
        },
        "s3Location": {
          "$ref": "#/$defs/S3Location"
        }
      },
      "type": "object"
    },
    "AutomatedReasoningRuleIdentifier": {
      "maxLength": 12,
      "pattern": "^[a-z0-9]{12}$",
      "type": "string"
    },
    "CacheDetail": {
      "properties": {
        "inputTokens": {
          "minimum": 0,
          "type": "integer"
        },
        "ttl": {
          "$ref": "#/$defs/CacheTTL"
        }
      },
      "required": [
        "inputTokens",
        "ttl"
      ],
      "type": "object"
    },
    "CacheDetailsList": {
      "items": {
        "$ref": "#/$defs/CacheDetail"
      },
      "type": "array"
    },
    "CachePointBlock": {
      "properties": {
        "ttl": {
          "$ref": "#/$defs/CacheTTL"
        },
        "type": {
          "$ref": "#/$defs/CachePointType"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "CachePointType": {
      "enum": [
        "default"
      ],
      "type": "string"
    },
    "CacheTTL": {
      "enum": [
        "1h",
        "5m"
      ],
      "type": "string"
    },
    "Citation": {
      "properties": {
        "location": {
          "$ref": "#/$defs/CitationLocation"
        },
        "source": {
          "type": "string"
        },
        "sourceContent": {
          "$ref": "#/$defs/CitationSourceContentList"
        },
        "title": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "CitationGeneratedContent": {
      "oneOf": [
        {
          "required": [
            "text"
          ]
        }
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "CitationGeneratedContentList": {
      "items": {
        "$ref": "#/$defs/CitationGeneratedContent"
      },
      "type": "array"
    },
    "CitationLocation": {
      "oneOf": [
        {
          "required": [
            "documentChar"
          ]
        },
        {
          "required": [
            "documentChunk"
          ]
        },
        {
          "required": [
            "documentPage"
          ]
        },
        {
          "required": [
            "searchResultLocation"
          ]
        },
        {
          "required": [
            "web"
          ]
        }
      ],
      "properties": {
        "documentChar": {
          "$ref": "#/$defs/DocumentCharLocation"
        },
        "documentChunk": {
          "$ref": "#/$defs/DocumentChunkLocation"
        },
        "documentPage": {
          "$ref": "#/$defs/DocumentPageLocation"
        },
        "searchResultLocation": {
          "$ref": "#/$defs/SearchResultLocation"
        },
        "web": {
          "$ref": "#/$defs/WebLocation"
        }
      },
      "type": "object"
    },
    "CitationSourceContent": {
      "oneOf": [
        {
          "required": [
            "text"
          ]
        }
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "CitationSourceContentList": {
      "items": {
        "$ref": "#/$defs/CitationSourceContent"
      },
      "type": "array"
    },
    "Citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "type": "array"
    },
    "CitationsConfig": {
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "CitationsContentBlock": {
      "properties": {
        "citations": {
          "$ref": "#/$defs/Citations"
        },
        "content": {
          "$ref": "#/$defs/CitationGeneratedContentList"
        }
      },
      "type": "object"
    },
    "ContentBlock": {
      "oneOf": [
        {
          "required": [
            "audio"
          ]
        },
        {
          "required": [
            "cachePoint"
          ]
        },
        {
          "required": [
            "citationsContent"
          ]
        },
        {
          "required": [
            "document"
          ]
        },
        {
          "required": [
            "guardContent"
          ]
        },
        {
          "required": [
            "image"
          ]
        },
        {
          "required": [
            "reasoningContent"
          ]
        },
        {
          "required": [
            "searchResult"
          ]
        },
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "toolAddition"
          ]
        },
        {
          "required": [
            "toolRemoval"
          ]
        },
        {
          "required": [
            "toolResult"
          ]
        },
        {
          "required": [
            "toolUse"
          ]
        },
        {
          "required": [
            "video"
          ]
        }
      ],
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioBlock"
        },
        "cachePoint": {
          "$ref": "#/$defs/CachePointBlock"
        },
        "citationsContent": {
          "$ref": "#/$defs/CitationsContentBlock"
        },
        "document": {
          "$ref": "#/$defs/DocumentBlock"
        },
        "guardContent": {
          "$ref": "#/$defs/GuardrailConverseContentBlock"
        },
        "image": {
          "$ref": "#/$defs/ImageBlock"
        },
        "reasoningContent": {
          "$ref": "#/$defs/ReasoningContentBlock"
        },
        "searchResult": {
          "$ref": "#/$defs/SearchResultBlock"
        },
        "text": {
          "type": "string"
        },
        "toolAddition": {
          "$ref": "#/$defs/ToolAdditionBlock"
        },
        "toolRemoval": {
          "$ref": "#/$defs/ToolRemovalBlock"
        },
        "toolResult": {
          "$ref": "#/$defs/ToolResultBlock"
        },
        "toolUse": {
          "$ref": "#/$defs/ToolUseBlock"
        },
        "video": {
          "$ref": "#/$defs/VideoBlock"
        }
      },
      "type": "object"
    },
    "ContentBlocks": {
      "items": {
        "$ref": "#/$defs/ContentBlock"
      },
      "type": "array"
    },
    "ConversationRole": {
      "enum": [
        "assistant",
        "system",
        "user"
      ],
      "type": "string"
    },
    "ConverseMetrics": {
      "properties": {
        "latencyMs": {
          "type": "integer"
        }
      },
      "required": [
        "latencyMs"
      ],
      "type": "object"
    },
    "ConverseOutput": {
      "oneOf": [
        {
          "required": [
            "message"
          ]
        }
      ],
      "properties": {
        "message": {
          "$ref": "#/$defs/Message"
        }
      },
      "type": "object"
    },
    "ConverseResponse": {
      "properties": {
        "additionalModelResponseFields": {},
        "metrics": {
          "$ref": "#/$defs/ConverseMetrics"
        },
        "output": {
          "$ref": "#/$defs/ConverseOutput"
        },
        "performanceConfig": {
          "$ref": "#/$defs/PerformanceConfiguration"
        },
        "serviceTier": {
          "$ref": "#/$defs/ServiceTier"
        },
        "stopReason": {
          "$ref": "#/$defs/StopReason"
        },
        "trace": {
          "$ref": "#/$defs/ConverseTrace"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "metrics",
        "output",
        "stopReason",
        "usage"
      ],
      "type": "object"
    },
    "ConverseTrace": {
      "properties": {
        "guardrail": {
          "$ref": "#/$defs/GuardrailTraceAssessment"
        },
        "promptRouter": {
          "$ref": "#/$defs/PromptRouterTrace"
        }
      },
      "type": "object"
    },
    "DocumentBlock": {
      "properties": {
        "citations": {
          "$ref": "#/$defs/CitationsConfig"
        },
        "context": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/DocumentFormat"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DocumentSource"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "type": "object"
    },
    "DocumentCharLocation": {
      "properties": {
        "documentIndex": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DocumentChunkLocation": {
      "properties": {
        "documentIndex": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DocumentContentBlock": {
      "oneOf": [
        {
          "required": [
            "text"
          ]
        }
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "DocumentContentBlocks": {
      "items": {
        "$ref": "#/$defs/DocumentContentBlock"
      },
      "type": "array"
    },
    "DocumentFormat": {
      "enum": [
        "csv",
        "doc",
        "docx",
        "html",
        "md",
        "pdf",
        "txt",
        "xls",
        "xlsx"
      ],
      "type": "string"
    },
    "DocumentPageLocation": {
      "properties": {
        "documentIndex": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DocumentSource": {
      "oneOf": [
        {
          "required": [
            "bytes"
          ]
        },
        {
          "required": [
            "content"
          ]
        },
        {
          "required": [
            "s3Location"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ],
      "properties": {
        "bytes": {
          "contentEncoding": "base64",
          "minLength": 1,
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/DocumentContentBlocks"
        },
        "s3Location": {
          "$ref": "#/$defs/S3Location"
        },
        "text": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ErrorBlock": {
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "GuardrailArn": {
      "maxLength": 2048,
      "pattern": "^(arn:aws(-[^:]+)?:bedrock:[a-z0-9-]{1,20}:[0-9]{12}:guardrail/[a-z0-9]+)$",
      "type": "string"
    },
    "GuardrailAssessment": {
      "properties": {
        "appliedGuardrailDetails": {
          "$ref": "#/$defs/AppliedGuardrailDetails"
        },
        "automatedReasoningPolicy": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningPolicyAssessment"
        },
        "contentPolicy": {
          "$ref": "#/$defs/GuardrailContentPolicyAssessment"
        },
        "contextualGroundingPolicy": {
          "$ref": "#/$defs/GuardrailContextualGroundingPolicyAssessment"
        },
        "invocationMetrics": {
          "$ref": "#/$defs/GuardrailInvocationMetrics"
        },
        "sensitiveInformationPolicy": {
          "$ref": "#/$defs/GuardrailSensitiveInformationPolicyAssessment"
        },
        "topicPolicy": {
          "$ref": "#/$defs/GuardrailTopicPolicyAssessment"
        },
        "wordPolicy": {
          "$ref": "#/$defs/GuardrailWordPolicyAssessment"
        }
      },
      "type": "object"
    },
    "GuardrailAssessmentList": {
      "items": {
        "$ref": "#/$defs/GuardrailAssessment"
      },
      "type": "array"
    },
    "GuardrailAssessmentListMap": {
      "additionalProperties": {
        "$ref": "#/$defs/GuardrailAssessmentList"
      },
      "type": "object"
    },
    "GuardrailAssessmentMap": {
      "additionalProperties": {
        "$ref": "#/$defs/GuardrailAssessment"
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningDifferenceScenarioList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningScenario"
      },
      "maxItems": 2,
      "type": "array"
    },
    "GuardrailAutomatedReasoningFinding": {
      "oneOf": [
        {
          "required": [
            "impossible"
          ]
        },
        {
          "required": [
            "invalid"
          ]
        },
        {
          "required": [
            "noTranslations"
          ]
        },
        {
          "required": [
            "satisfiable"
          ]
        },
        {
          "required": [
            "tooComplex"
          ]
        },
        {
          "required": [
            "translationAmbiguous"
          ]
        },
        {
          "required": [
            "valid"
          ]
        }
      ],
      "properties": {
        "impossible": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningImpossibleFinding"
        },
        "invalid": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningInvalidFinding"
        },
        "noTranslations": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningNoTranslationsFinding"
        },
        "satisfiable": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningSatisfiableFinding"
        },
        "tooComplex": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTooComplexFinding"
        },
        "translationAmbiguous": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslationAmbiguousFinding"
        },
        "valid": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningValidFinding"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningFindingList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningFinding"
      },
      "type": "array"
    },
    "GuardrailAutomatedReasoningImpossibleFinding": {
      "properties": {
        "contradictingRules": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningRuleList"
        },
        "logicWarning": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningLogicWarning"
        },
        "translation": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslation"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningInputTextReference": {
      "properties": {
        "text": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementNaturalLanguageContent"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningInputTextReferenceList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningInputTextReference"
      },
      "type": "array"
    },
    "GuardrailAutomatedReasoningInvalidFinding": {
      "properties": {
        "contradictingRules": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningRuleList"
        },
        "logicWarning": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningLogicWarning"
        },
        "translation": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslation"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningLogicWarning": {
      "properties": {
        "claims": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementList"
        },
        "premises": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementList"
        },
        "type": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningLogicWarningType"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningLogicWarningType": {
      "enum": [
        "ALWAYS_FALSE",
        "ALWAYS_TRUE"
      ],
      "type": "string"
    },
    "GuardrailAutomatedReasoningNoTranslationsFinding": {
      "type": "object"
    },
    "GuardrailAutomatedReasoningPoliciesProcessed": {
      "type": "integer"
    },
    "GuardrailAutomatedReasoningPolicyAssessment": {
      "properties": {
        "findings": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningFindingList"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningPolicyUnitsProcessed": {
      "type": "integer"
    },
    "GuardrailAutomatedReasoningPolicyVersionArn": {
      "maxLength": 2048,
      "pattern": "^arn:aws(-[^:]+)?:bedrock:[a-z0-9-]{1,20}:[0-9]{12}:automated-reasoning-policy/[a-z0-9]{12}(:([1-9][0-9]{0,11}))?$",
      "type": "string"
    },
    "GuardrailAutomatedReasoningRule": {
      "properties": {
        "identifier": {
          "$ref": "#/$defs/AutomatedReasoningRuleIdentifier"
        },
        "policyVersionArn": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningPolicyVersionArn"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningRuleList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningRule"
      },
      "type": "array"
    },
    "GuardrailAutomatedReasoningSatisfiableFinding": {
      "properties": {
        "claimsFalseScenario": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningScenario"
        },
        "claimsTrueScenario": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningScenario"
        },
        "logicWarning": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningLogicWarning"
        },
        "translation": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslation"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningScenario": {
      "properties": {
        "statements": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementList"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningStatement": {
      "properties": {
        "logic": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementLogicContent"
        },
        "naturalLanguage": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementNaturalLanguageContent"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningStatementList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningStatement"
      },
      "type": "array"
    },
    "GuardrailAutomatedReasoningStatementLogicContent": {
      "maxLength": 1000,
      "type": "string"
    },
    "GuardrailAutomatedReasoningStatementNaturalLanguageContent": {
      "maxLength": 1000,
      "type": "string"
    },
    "GuardrailAutomatedReasoningTooComplexFinding": {
      "type": "object"
    },
    "GuardrailAutomatedReasoningTranslation": {
      "properties": {
        "claims": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementList"
        },
        "confidence": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslationConfidence"
        },
        "premises": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementList"
        },
        "untranslatedClaims": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningInputTextReferenceList"
        },
        "untranslatedPremises": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningInputTextReferenceList"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningTranslationAmbiguousFinding": {
      "properties": {
        "differenceScenarios": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningDifferenceScenarioList"
        },
        "options": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslationOptionList"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningTranslationConfidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "GuardrailAutomatedReasoningTranslationList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningTranslation"
      },
      "type": "array"
    },
    "GuardrailAutomatedReasoningTranslationOption": {
      "properties": {
        "translations": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslationList"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningTranslationOptionList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningTranslationOption"
      },
      "maxItems": 2,
      "type": "array"
    },
    "GuardrailAutomatedReasoningValidFinding": {
      "properties": {
        "claimsTrueScenario": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningScenario"
        },
        "logicWarning": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningLogicWarning"
        },
        "supportingRules": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningRuleList"
        },
        "translation": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslation"
        }
      },
      "type": "object"
    },
    "GuardrailContentFilter": {
      "properties": {
        "action": {
          "$ref": "#/$defs/GuardrailContentPolicyAction"
        },
        "confidence": {
          "$ref": "#/$defs/GuardrailContentFilterConfidence"
        },
        "detected": {
          "type": "boolean"
        },
        "filterStrength": {
          "$ref": "#/$defs/GuardrailContentFilterStrength"
        },
        "type": {
          "$ref": "#/$defs/GuardrailContentFilterType"
        }
      },
      "required": [
        "action",
        "confidence",
        "type"
      ],
      "type": "object"
    },
    "GuardrailContentFilterConfidence": {
      "enum": [
        "HIGH",
        "LOW",
