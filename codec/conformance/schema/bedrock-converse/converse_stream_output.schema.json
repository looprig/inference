{
  "$defs": {
    "AccountId": {
      "pattern": "^[0-9]{12}$",
      "type": "string"
    },
    "AppliedGuardrailDetails": {
      "properties": {
        "guardrailArn": {
          "$ref": "#/$defs/GuardrailArn"
        },
        "guardrailId": {
          "$ref": "#/$defs/GuardrailId"
        },
        "guardrailOrigin": {
          "$ref": "#/$defs/GuardrailOriginList"
        },
        "guardrailOwnership": {
          "$ref": "#/$defs/GuardrailOwnership"
        },
        "guardrailVersion": {
          "$ref": "#/$defs/GuardrailVersion"
        }
      },
      "type": "object"
    },
    "AutomatedReasoningRuleIdentifier": {
      "maxLength": 12,
      "pattern": "^[a-z0-9]{12}$",
      "type": "string"
    },
    "CacheDetail": {
      "properties": {
        "inputTokens": {
          "minimum": 0,
          "type": "integer"
        },
        "ttl": {
          "$ref": "#/$defs/CacheTTL"
        }
      },
      "required": [
        "inputTokens",
        "ttl"
      ],
      "type": "object"
    },
    "CacheDetailsList": {
      "items": {
        "$ref": "#/$defs/CacheDetail"
      },
      "type": "array"
    },
    "CacheTTL": {
      "enum": [
        "1h",
        "5m"
      ],
      "type": "string"
    },
    "CitationLocation": {
      "oneOf": [
        {
          "required": [
            "documentChar"
          ]
        },
        {
          "required": [
            "documentChunk"
          ]
        },
        {
          "required": [
            "documentPage"
          ]
        },
        {
          "required": [
            "searchResultLocation"
          ]
        },
        {
          "required": [
            "web"
          ]
        }
      ],
      "properties": {
        "documentChar": {
          "$ref": "#/$defs/DocumentCharLocation"
        },
        "documentChunk": {
          "$ref": "#/$defs/DocumentChunkLocation"
        },
        "documentPage": {
          "$ref": "#/$defs/DocumentPageLocation"
        },
        "searchResultLocation": {
          "$ref": "#/$defs/SearchResultLocation"
        },
        "web": {
          "$ref": "#/$defs/WebLocation"
        }
      },
      "type": "object"
    },
    "CitationSourceContentDelta": {
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "CitationSourceContentListDelta": {
      "items": {
        "$ref": "#/$defs/CitationSourceContentDelta"
      },
      "type": "array"
    },
    "CitationsDelta": {
      "properties": {
        "location": {
          "$ref": "#/$defs/CitationLocation"
        },
        "source": {
          "type": "string"
        },
        "sourceContent": {
          "$ref": "#/$defs/CitationSourceContentListDelta"
        },
        "title": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ContentBlockDelta": {
      "oneOf": [
        {
          "required": [
            "citation"
          ]
        },
        {
          "required": [
            "image"
          ]
        },
        {
          "required": [
            "reasoningContent"
          ]
        },
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "toolResult"
          ]
        },
        {
          "required": [
            "toolUse"
          ]
        }
      ],
      "properties": {
        "citation": {
          "$ref": "#/$defs/CitationsDelta"
        },
        "image": {
          "$ref": "#/$defs/ImageBlockDelta"
        },
        "reasoningContent": {
          "$ref": "#/$defs/ReasoningContentBlockDelta"
        },
        "text": {
          "type": "string"
        },
        "toolResult": {
          "$ref": "#/$defs/ToolResultBlocksDelta"
        },
        "toolUse": {
          "$ref": "#/$defs/ToolUseBlockDelta"
        }
      },
      "type": "object"
    },
    "ContentBlockDeltaEvent": {
      "properties": {
        "contentBlockIndex": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "delta": {
          "$ref": "#/$defs/ContentBlockDelta"
        }
      },
      "required": [
        "contentBlockIndex",
        "delta"
      ],
      "type": "object"
    },
    "ContentBlockStart": {
      "oneOf": [
        {
          "required": [
            "image"
          ]
        },
        {
          "required": [
            "toolResult"
          ]
        },
        {
          "required": [
            "toolUse"
          ]
        }
      ],
      "properties": {
        "image": {
          "$ref": "#/$defs/ImageBlockStart"
        },
        "toolResult": {
          "$ref": "#/$defs/ToolResultBlockStart"
        },
        "toolUse": {
          "$ref": "#/$defs/ToolUseBlockStart"
        }
      },
      "type": "object"
    },
    "ContentBlockStartEvent": {
      "properties": {
        "contentBlockIndex": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "start": {
          "$ref": "#/$defs/ContentBlockStart"
        }
      },
      "required": [
        "contentBlockIndex",
        "start"
      ],
      "type": "object"
    },
    "ContentBlockStopEvent": {
      "properties": {
        "contentBlockIndex": {
          "$ref": "#/$defs/NonNegativeInteger"
        }
      },
      "required": [
        "contentBlockIndex"
      ],
      "type": "object"
    },
    "ConversationRole": {
      "enum": [
        "assistant",
        "system",
        "user"
      ],
      "type": "string"
    },
    "ConverseStreamMetadataEvent": {
      "properties": {
        "metrics": {
          "$ref": "#/$defs/ConverseStreamMetrics"
        },
        "performanceConfig": {
          "$ref": "#/$defs/PerformanceConfiguration"
        },
        "serviceTier": {
          "$ref": "#/$defs/ServiceTier"
        },
        "trace": {
          "$ref": "#/$defs/ConverseStreamTrace"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "metrics",
        "usage"
      ],
      "type": "object"
    },
    "ConverseStreamMetrics": {
      "properties": {
        "latencyMs": {
          "type": "integer"
        }
      },
      "required": [
        "latencyMs"
      ],
      "type": "object"
    },
    "ConverseStreamOutput": {
      "oneOf": [
        {
          "required": [
            "contentBlockDelta"
          ]
        },
        {
          "required": [
            "contentBlockStart"
          ]
        },
        {
          "required": [
            "contentBlockStop"
          ]
        },
        {
          "required": [
            "internalServerException"
          ]
        },
        {
          "required": [
            "messageStart"
          ]
        },
        {
          "required": [
            "messageStop"
          ]
        },
        {
          "required": [
            "metadata"
          ]
        },
        {
          "required": [
            "modelStreamErrorException"
          ]
        },
        {
          "required": [
            "serviceUnavailableException"
          ]
        },
        {
          "required": [
            "throttlingException"
          ]
        },
        {
          "required": [
            "validationException"
          ]
        }
      ],
      "properties": {
        "contentBlockDelta": {
          "$ref": "#/$defs/ContentBlockDeltaEvent"
        },
        "contentBlockStart": {
          "$ref": "#/$defs/ContentBlockStartEvent"
        },
        "contentBlockStop": {
          "$ref": "#/$defs/ContentBlockStopEvent"
        },
        "internalServerException": {
          "$ref": "#/$defs/InternalServerException"
        },
        "messageStart": {
          "$ref": "#/$defs/MessageStartEvent"
        },
        "messageStop": {
          "$ref": "#/$defs/MessageStopEvent"
        },
        "metadata": {
          "$ref": "#/$defs/ConverseStreamMetadataEvent"
        },
        "modelStreamErrorException": {
          "$ref": "#/$defs/ModelStreamErrorException"
        },
        "serviceUnavailableException": {
          "$ref": "#/$defs/ServiceUnavailableException"
        },
        "throttlingException": {
          "$ref": "#/$defs/ThrottlingException"
        },
        "validationException": {
          "$ref": "#/$defs/ValidationException"
        }
      },
      "type": "object"
    },
    "ConverseStreamTrace": {
      "properties": {
        "guardrail": {
          "$ref": "#/$defs/GuardrailTraceAssessment"
        },
        "promptRouter": {
          "$ref": "#/$defs/PromptRouterTrace"
        }
      },
      "type": "object"
    },
    "DocumentCharLocation": {
      "properties": {
        "documentIndex": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DocumentChunkLocation": {
      "properties": {
        "documentIndex": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DocumentPageLocation": {
      "properties": {
        "documentIndex": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ErrorBlock": {
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "GuardrailArn": {
      "maxLength": 2048,
      "pattern": "^(arn:aws(-[^:]+)?:bedrock:[a-z0-9-]{1,20}:[0-9]{12}:guardrail/[a-z0-9]+)$",
      "type": "string"
    },
    "GuardrailAssessment": {
      "properties": {
        "appliedGuardrailDetails": {
          "$ref": "#/$defs/AppliedGuardrailDetails"
        },
        "automatedReasoningPolicy": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningPolicyAssessment"
        },
        "contentPolicy": {
          "$ref": "#/$defs/GuardrailContentPolicyAssessment"
        },
        "contextualGroundingPolicy": {
          "$ref": "#/$defs/GuardrailContextualGroundingPolicyAssessment"
        },
        "invocationMetrics": {
          "$ref": "#/$defs/GuardrailInvocationMetrics"
        },
        "sensitiveInformationPolicy": {
          "$ref": "#/$defs/GuardrailSensitiveInformationPolicyAssessment"
        },
        "topicPolicy": {
          "$ref": "#/$defs/GuardrailTopicPolicyAssessment"
        },
        "wordPolicy": {
          "$ref": "#/$defs/GuardrailWordPolicyAssessment"
        }
      },
      "type": "object"
    },
    "GuardrailAssessmentList": {
      "items": {
        "$ref": "#/$defs/GuardrailAssessment"
      },
      "type": "array"
    },
    "GuardrailAssessmentListMap": {
      "additionalProperties": {
        "$ref": "#/$defs/GuardrailAssessmentList"
      },
      "type": "object"
    },
    "GuardrailAssessmentMap": {
      "additionalProperties": {
        "$ref": "#/$defs/GuardrailAssessment"
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningDifferenceScenarioList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningScenario"
      },
      "maxItems": 2,
      "type": "array"
    },
    "GuardrailAutomatedReasoningFinding": {
      "oneOf": [
        {
          "required": [
            "impossible"
          ]
        },
        {
          "required": [
            "invalid"
          ]
        },
        {
          "required": [
            "noTranslations"
          ]
        },
        {
          "required": [
            "satisfiable"
          ]
        },
        {
          "required": [
            "tooComplex"
          ]
        },
        {
          "required": [
            "translationAmbiguous"
          ]
        },
        {
          "required": [
            "valid"
          ]
        }
      ],
      "properties": {
        "impossible": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningImpossibleFinding"
        },
        "invalid": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningInvalidFinding"
        },
        "noTranslations": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningNoTranslationsFinding"
        },
        "satisfiable": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningSatisfiableFinding"
        },
        "tooComplex": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTooComplexFinding"
        },
        "translationAmbiguous": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslationAmbiguousFinding"
        },
        "valid": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningValidFinding"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningFindingList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningFinding"
      },
      "type": "array"
    },
    "GuardrailAutomatedReasoningImpossibleFinding": {
      "properties": {
        "contradictingRules": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningRuleList"
        },
        "logicWarning": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningLogicWarning"
        },
        "translation": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslation"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningInputTextReference": {
      "properties": {
        "text": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementNaturalLanguageContent"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningInputTextReferenceList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningInputTextReference"
      },
      "type": "array"
    },
    "GuardrailAutomatedReasoningInvalidFinding": {
      "properties": {
        "contradictingRules": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningRuleList"
        },
        "logicWarning": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningLogicWarning"
        },
        "translation": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslation"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningLogicWarning": {
      "properties": {
        "claims": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementList"
        },
        "premises": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementList"
        },
        "type": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningLogicWarningType"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningLogicWarningType": {
      "enum": [
        "ALWAYS_FALSE",
        "ALWAYS_TRUE"
      ],
      "type": "string"
    },
    "GuardrailAutomatedReasoningNoTranslationsFinding": {
      "type": "object"
    },
    "GuardrailAutomatedReasoningPoliciesProcessed": {
      "type": "integer"
    },
    "GuardrailAutomatedReasoningPolicyAssessment": {
      "properties": {
        "findings": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningFindingList"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningPolicyUnitsProcessed": {
      "type": "integer"
    },
    "GuardrailAutomatedReasoningPolicyVersionArn": {
      "maxLength": 2048,
      "pattern": "^arn:aws(-[^:]+)?:bedrock:[a-z0-9-]{1,20}:[0-9]{12}:automated-reasoning-policy/[a-z0-9]{12}(:([1-9][0-9]{0,11}))?$",
      "type": "string"
    },
    "GuardrailAutomatedReasoningRule": {
      "properties": {
        "identifier": {
          "$ref": "#/$defs/AutomatedReasoningRuleIdentifier"
        },
        "policyVersionArn": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningPolicyVersionArn"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningRuleList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningRule"
      },
      "type": "array"
    },
    "GuardrailAutomatedReasoningSatisfiableFinding": {
      "properties": {
        "claimsFalseScenario": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningScenario"
        },
        "claimsTrueScenario": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningScenario"
        },
        "logicWarning": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningLogicWarning"
        },
        "translation": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslation"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningScenario": {
      "properties": {
        "statements": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementList"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningStatement": {
      "properties": {
        "logic": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementLogicContent"
        },
        "naturalLanguage": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementNaturalLanguageContent"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningStatementList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningStatement"
      },
      "type": "array"
    },
    "GuardrailAutomatedReasoningStatementLogicContent": {
      "maxLength": 1000,
      "type": "string"
    },
    "GuardrailAutomatedReasoningStatementNaturalLanguageContent": {
      "maxLength": 1000,
      "type": "string"
    },
    "GuardrailAutomatedReasoningTooComplexFinding": {
      "type": "object"
    },
    "GuardrailAutomatedReasoningTranslation": {
      "properties": {
        "claims": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementList"
        },
        "confidence": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslationConfidence"
        },
        "premises": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningStatementList"
        },
        "untranslatedClaims": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningInputTextReferenceList"
        },
        "untranslatedPremises": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningInputTextReferenceList"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningTranslationAmbiguousFinding": {
      "properties": {
        "differenceScenarios": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningDifferenceScenarioList"
        },
        "options": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslationOptionList"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningTranslationConfidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "GuardrailAutomatedReasoningTranslationList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningTranslation"
      },
      "type": "array"
    },
    "GuardrailAutomatedReasoningTranslationOption": {
      "properties": {
        "translations": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslationList"
        }
      },
      "type": "object"
    },
    "GuardrailAutomatedReasoningTranslationOptionList": {
      "items": {
        "$ref": "#/$defs/GuardrailAutomatedReasoningTranslationOption"
      },
      "maxItems": 2,
      "type": "array"
    },
    "GuardrailAutomatedReasoningValidFinding": {
      "properties": {
        "claimsTrueScenario": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningScenario"
        },
        "logicWarning": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningLogicWarning"
        },
        "supportingRules": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningRuleList"
        },
        "translation": {
          "$ref": "#/$defs/GuardrailAutomatedReasoningTranslation"
        }
      },
      "type": "object"
    },
    "GuardrailContentFilter": {
      "properties": {
        "action": {
          "$ref": "#/$defs/GuardrailContentPolicyAction"
        },
        "confidence": {
          "$ref": "#/$defs/GuardrailContentFilterConfidence"
        },
        "detected": {
          "type": "boolean"
        },
        "filterStrength": {
          "$ref": "#/$defs/GuardrailContentFilterStrength"
        },
        "type": {
          "$ref": "#/$defs/GuardrailContentFilterType"
        }
      },
      "required": [
        "action",
        "confidence",
        "type"
      ],
      "type": "object"
    },
    "GuardrailContentFilterConfidence": {
      "enum": [
        "HIGH",
        "LOW",
        "MEDIUM",
        "NONE"
      ],
      "type": "string"
    },
    "GuardrailContentFilterList": {
      "items": {
        "$ref": "#/$defs/GuardrailContentFilter"
      },
      "type": "array"
    },
    "GuardrailContentFilterStrength": {
      "enum": [
        "HIGH",
        "LOW",
        "MEDIUM",
        "NONE"
      ],
      "type": "string"
    },
    "GuardrailContentFilterType": {
      "enum": [
        "HATE",
        "INSULTS",
        "MISCONDUCT",
        "PROMPT_ATTACK",
        "SEXUAL",
        "VIOLENCE"
      ],
      "type": "string"
    },
    "GuardrailContentPolicyAction": {
      "enum": [
        "BLOCKED",
        "NONE"
      ],
      "type": "string"
    },
    "GuardrailContentPolicyAssessment": {
      "properties": {
        "filters": {
          "$ref": "#/$defs/GuardrailContentFilterList"
        }
      },
      "required": [
        "filters"
      ],
      "type": "object"
    },
    "GuardrailContentPolicyImageUnitsProcessed": {
      "type": "integer"
    },
    "GuardrailContentPolicyUnitsProcessed": {
      "type": "integer"
    },
    "GuardrailContextualGroundingFilter": {
      "properties": {
        "action": {
          "$ref": "#/$defs/GuardrailContextualGroundingPolicyAction"
        },
        "detected": {
          "type": "boolean"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "threshold": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/GuardrailContextualGroundingFilterType"
        }
      },
      "required": [
        "action",
        "score",
        "threshold",
        "type"
      ],
      "type": "object"
    },
    "GuardrailContextualGroundingFilterType": {
      "enum": [
        "GROUNDING",
        "RELEVANCE"
      ],
      "type": "string"
    },
    "GuardrailContextualGroundingFilters": {
      "items": {
        "$ref": "#/$defs/GuardrailContextualGroundingFilter"
      },
      "type": "array"
    },
    "GuardrailContextualGroundingPolicyAction": {
      "enum": [
        "BLOCKED",
        "NONE"
      ],
      "type": "string"
    },
    "GuardrailContextualGroundingPolicyAssessment": {
      "properties": {
        "filters": {
          "$ref": "#/$defs/GuardrailContextualGroundingFilters"
        }
      },
      "type": "object"
    },
    "GuardrailContextualGroundingPolicyUnitsProcessed": {
      "type": "integer"
    },
    "GuardrailCoverage": {
      "properties": {
        "images": {
          "$ref": "#/$defs/GuardrailImageCoverage"
        },
        "textCharacters": {
          "$ref": "#/$defs/GuardrailTextCharactersCoverage"
        }
      },
      "type": "object"
    },
    "GuardrailCustomWord": {
      "properties": {
        "action": {
          "$ref": "#/$defs/GuardrailWordPolicyAction"
        },
        "detected": {
          "type": "boolean"
        },
        "match": {
          "type": "string"
        }
